[Unit]
Description=WhisperX Queue API (FastAPI)
After=network-online.target redis-server.service
Requires=redis-server.service

[Service]
User=<USER>
Group=<USER>
WorkingDirectory=/home/<USER>/whisperx-api-queue
EnvironmentFile=/etc/default/whisperx-api-queue
ExecStart=/home/<USER>/whisperx/whenv/bin/uvicorn api:app --host 0.0.0.0 --port 7860 --workers 1
Restart=on-failure

[Install]
WantedBy=multi-user.target
